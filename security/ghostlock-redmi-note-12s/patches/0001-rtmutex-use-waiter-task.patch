From 3bfdc63936dd4773109b7b8c280c0f3b5ae7d349 Mon Sep 17 00:00:00 2001
From: Keenan Dong <keenanat2000@gmail.com>
Subject: [PATCH] rtmutex: use waiter->task in remove_waiter()

Backport the upstream CVE-2026-43499 fix to Xiaomi's legacy 4.19
rtmutex implementation. This tree predates scoped_guard, so use the
existing raw_spin_lock()/raw_spin_unlock() style.

Upstream: 3bfdc63936dd4773109b7b8c280c0f3b5ae7d349
Source tree: MiCode/Xiaomi_Kernel_OpenSource, ref sea-t-oss
Source file blob at preparation time: a5ec4f68527e533fb25e447ed18e2efd179a21b5

---
 kernel/locking/rtmutex.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/kernel/locking/rtmutex.c b/kernel/locking/rtmutex.c
--- a/kernel/locking/rtmutex.c
+++ b/kernel/locking/rtmutex.c
@@ -1062,6 +1062,8 @@
 /*
  * Remove a waiter from a lock and give up
  *
  * Must be called with lock->wait_lock held and interrupts disabled. I must
  * have just failed to try_to_take_rt_mutex().
+ *
+ * When invoked from rt_mutex_start_proxy_lock(), waiter->task != current!
  */
@@ -1070,4 +1072,5 @@
 {
 	bool is_top_waiter = (waiter == rt_mutex_top_waiter(lock));
 	struct task_struct *owner = rt_mutex_owner(lock);
+	struct task_struct *waiter_task = waiter->task;
 	struct rt_mutex *next_lock;
@@ -1075,6 +1078,6 @@
 	lockdep_assert_held(&lock->wait_lock);
 
-	raw_spin_lock(&current->pi_lock);
+	raw_spin_lock(&waiter_task->pi_lock);
 	rt_mutex_dequeue(lock, waiter);
-	current->pi_blocked_on = NULL;
-	raw_spin_unlock(&current->pi_lock);
+	waiter_task->pi_blocked_on = NULL;
+	raw_spin_unlock(&waiter_task->pi_lock);
@@ -1115,2 +1118,2 @@
 	rt_mutex_adjust_prio_chain(owner, RT_MUTEX_MIN_CHAINWALK, lock,
-				   next_lock, NULL, current);
+				   next_lock, NULL, waiter_task);
 
-- 
2.43.0
